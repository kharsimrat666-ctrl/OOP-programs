#include <iostream>
using namespace std;

class Student
{
    int roll;
    string name;
    int marks;

public:
    void getData()
    {
        cout << "Enter Roll No: ";
        cin >> roll;

        cout << "Enter Name: ";
        cin >> name;

        cout << "Enter Marks: ";
        cin >> marks;
    }

    void showData()
    {
        cout << "\nRoll No: " << roll;
        cout << "\nName: " << name;
        cout << "\nMarks: " << marks << endl;
    }

    int getRoll()
    {
        return roll;
    }
};

int main()
{
    Student s[3];
    int i, searchRoll;

    // Enter student details
    for (i = 0; i < 3; i++)
    {
        cout << "\nStudent " << i + 1 << endl;
        s[i].getData();
    }

    // Display students
    cout << "\n--- Student Records ---\n";

    for (i = 0; i < 3; i++)
    {
        s[i].showData();
    }

    // Search student
    cout << "\nEnter Roll No to search: ";
    cin >> searchRoll;

    for (i = 0; i < 3; i++)
    {
        if (s[i].getRoll() == searchRoll)
        {
            cout << "\nStudent Found!\n";
            s[i].showData();
            return 0;
        }
    }

    cout << "\nStudent Not Found!";

    return 0;
}
