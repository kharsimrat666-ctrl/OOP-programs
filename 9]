#include <iostream>
using namespace std;

class Vehicle
{
protected:
    string brand;

public:
    void setBrand(string b)
    {
        brand = b;
    }
};

class Car : public Vehicle
{
private:
    int seats;

public:
    void setCar(int s)
    {
        seats = s;
    }

    void display()
    {
        cout << "Car Brand: " << brand << endl;
        cout << "Seats: " << seats << endl;
    }
};

class Truck : public Vehicle
{
private:
    int load;

public:
    void setTruck(int l)
    {
        load = l;
    }

    void display()
    {
        cout << "Truck Brand: " << brand << endl;
        cout << "Load Capacity: " << load << " tons" << endl;
    }
};

int main()
{
    Car c;
    c.setBrand("Toyota");
    c.setCar(5);

    Truck t;
    t.setBrand("Tata");
    t.setTruck(10);

    cout << "Car Details:" << endl;
    c.display();

    cout << "\nTruck Details:" << endl;
    t.display();

    return 0;
}
