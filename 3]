#include <iostream>
using namespace std;

class Employee
{
private:
    int id;
    string name;
    float salary;

public:
    void setData(int i, string n, float s)
    {
        id = i;
        name = n;
        salary = s;
    }

    void display()
    {
        cout << "Employee ID: " << id << endl;
        cout << "Employee Name: " << name << endl;
        cout << "Salary: " << salary << endl;
    }
};

int main()
{
    Employee e[2];

    e[0].setData(101, "Rahul", 30000);
    e[1].setData(102, "Amit", 35000);

    int password;

    cout << "Enter authorization password: ";
    cin >> password;

    if (password == 1234)
    {
        cout << "\nEmployee Records\n";

        for (int i = 0; i < 2; i++)
        {
            e[i].display();
            cout << "----------------" << endl;
        }
    }
    else
    {
        cout << "Access Denied!" << endl;
    }

    return 0;
}
