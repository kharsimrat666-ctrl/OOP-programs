#include <iostream>
using namespace std;

class Person
{
protected:
    string name;
    int age;

public:
    void setPerson(string n, int a)
    {
        name = n;
        age = a;
    }
};

class Student : public Person
{
private:
    int rollNo;

public:
    void setStudent(int r)
    {
        rollNo = r;
    }

    void display()
    {
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "Roll No: " << rollNo << endl;
    }
};

int main()
{
    Student s;

    s.setPerson("Rahul", 20);
    s.setStudent(101);

    s.display();

    return 0;
}
